      "relations": [{"rel": "located_in", "to": ["room"]}, {"rel": "wired_to", "to": ["patch_panel", "switch", "router"]}]},
    {"id": "phone", "group": "network", "icon": "Phone", "attrs": [
      {"name": "model", "type": "text"}, {"name": "connection", "type": "select", "options": ["dect", "sip", "analog"]}],
      "relations": [{"rel": "located_in", "to": ["room"]}, {"rel": "dect_base", "to": ["router"]}]},

    {"id": "rack", "group": "infrastructure", "icon": "Rows4", "attrs": [
