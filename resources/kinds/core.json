      "relations": [{"rel": "located_in", "to": ["room"]}, {"rel": "wired_to", "to": ["switch", "router", "lan_port"]}, {"rel": "powered_by", "to": ["outlet", "smart_plug", "switch"]}]},
    {"id": "switch", "group": "network", "icon": "Network", "attrs": [
