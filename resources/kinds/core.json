{
  "generic": ["related_to", "depends_on"],
  "kinds": [
    {"id": "person", "group": "general", "icon": "UserRound", "attrs": [
      {"name": "email", "type": "text"}, {"name": "role", "type": "text"}],
      "relations": [{"rel": "responsible_for", "to": ["*"]}]},
    {"id": "device", "group": "general", "icon": "Cpu", "attrs": [
      {"name": "manufacturer", "type": "text"}, {"name": "model", "type": "text"}, {"name": "serial", "type": "text"},
      {"name": "ip", "type": "ip"}, {"name": "mac", "type": "text"}],
      "relations": [{"rel": "located_in", "to": ["room"]}, {"rel": "mounted_in", "to": ["rack"]}, {"rel": "powered_by", "to": ["outlet", "smart_plug"]}, {"rel": "wired_to", "to": ["switch", "router", "lan_port"]}, {"rel": "uplink", "to": ["router", "repeater", "access_point"]}]},

    {"id": "floor", "group": "building", "icon": "Layers", "attrs": [
