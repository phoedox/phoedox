      "relations": [{"rel": "installed_on", "to": ["server", "vm", "lxc", "device"]}]},
    {"id": "service", "group": "software", "icon": "Workflow", "attrs": [
      {"name": "url", "type": "url"}, {"name": "port", "type": "number"}, {"name": "version", "type": "text"}],
      "relations": [{"rel": "runs_on", "to": ["server", "vm", "lxc", "container"]}, {"rel": "uses", "to": ["database", "service"]}]},
    {"id": "database", "group": "software", "icon": "Database", "attrs": [
      {"name": "engine", "type": "select", "options": ["postgres", "mysql", "mariadb", "sqlite", "mongodb", "redis", "other"]}, {"name": "version", "type": "text"}, {"name": "host", "type": "text"}],
      "relations": [{"rel": "runs_on", "to": ["server", "vm", "lxc", "container"]}]},
    {"id": "vm", "group": "software", "icon": "Monitor", "attrs": [
      {"name": "vmid", "type": "number"}, {"name": "os", "type": "text"}, {"name": "ip", "type": "ip"},
      {"name": "vcpu", "type": "number"}, {"name": "ram", "type": "number", "unit": "GB"}],
      "relations": [{"rel": "runs_on", "to": ["server"]}, {"rel": "managed_by", "to": ["software"]}]},
    {"id": "lxc", "group": "software", "icon": "Box", "attrs": [
      {"name": "ctid", "type": "number"}, {"name": "os", "type": "text"}, {"name": "ip", "type": "ip"}],
      "relations": [{"rel": "runs_on", "to": ["server"]}, {"rel": "managed_by", "to": ["software"]}]},
    {"id": "stack", "group": "software", "icon": "Boxes", "attrs": [
      {"name": "compose_path", "type": "text"}, {"name": "status", "type": "select", "options": ["running", "stopped"]}],
      "relations": [{"rel": "managed_by", "to": ["software"]}, {"rel": "runs_on", "to": ["vm", "server", "lxc"]}]},
    {"id": "container", "group": "software", "icon": "Container", "attrs": [
      {"name": "image", "type": "text", "required": true}, {"name": "ports", "type": "text"}],
      "relations": [{"rel": "part_of", "to": ["stack"]}, {"rel": "runs_on", "to": ["vm", "server", "lxc"]}]}
  ]
}
