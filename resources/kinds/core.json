      "relations": [{"rel": "located_in", "to": ["room"]}]},
    {"id": "server", "group": "infrastructure", "icon": "Server", "attrs": [
      {"name": "hostname", "type": "text"}, {"name": "ip", "type": "ip"}, {"name": "os", "type": "text"}, {"name": "height_units", "type": "number", "unit": "U"}],
