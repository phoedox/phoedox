    {"id": "light", "group": "power", "icon": "Lightbulb", "attrs": [
      {"name": "ha_entity", "type": "text"}],
      "relations": [{"rel": "located_in", "to": ["room"]}, {"rel": "switched_by", "to": ["smart_plug"]}]},

    {"id": "software", "group": "software", "icon": "Package", "attrs": [
